# Copy to .env and fill in. .env is gitignored and excluded from the Docker
# image; in production these are set as real environment variables.

# --- required: OpenSky Network OAuth client credentials -------------------
# https://opensky-network.org/ -> account -> API clients
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- optional: everything below has a working default ---------------------

# Seconds between refreshes. Minimum 60. Each refresh costs 4 of OpenSky's
# 4,000 daily credits, so even 60s (5,760/day) would exhaust the quota -- keep
# this at 300 or above for anything that runs all day.
# SKYLENS_REFRESH_SECONDS=900

# Where the service reads models and data, and where it writes runtime state.
# Defaults are derived from the repo layout; set these in a container.
# SKYLENS_MODELS_DIR=/app/models
# SKYLENS_DATA_DIR=/app/data
# SKYLENS_STATE_DIR=/var/lib/skylens

# Comma-separated allowlist. Defaults to "*" — narrow this before exposing the
# API beyond your LAN.
# SKYLENS_CORS_ALLOW_ORIGINS=https://app.example.com,http://localhost:8081

# "text" (human-readable) or "json" (one object per line, for log aggregators).
# SKYLENS_LOG_FORMAT=text
# SKYLENS_LOG_LEVEL=INFO

# Upstream HTTP timeout in seconds.
# SKYLENS_HTTP_TIMEOUT=10

# Persist every run to the DuckDB warehouse in SKYLENS_STATE_DIR. Needed for
# the dashboard's history, the data-quality history and the cascade backtest.
# SKYLENS_WAREHOUSE_ENABLED=true

# Write cascade_forecast.json to disk on each refresh. Off by default; the API
# serves from memory.
# SKYLENS_WRITE_RUNTIME_JSON=0
